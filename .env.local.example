# Neon connection string — console.neon.tech > project > Connection Details
# Use the "pooled connection" string for the app; drizzle-kit works fine with either.
DATABASE_URL="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET="replace-with-a-generated-secret"

# Optional. Only used when running via `docker compose up` (see
# docker-compose.yml's redis/rabbitmq services) — the app works fine
# without them (dashboard just skips caching, order events aren't
# published). Leave unset for plain `npm run dev`.
# REDIS_URL="redis://localhost:6379"
# RABBITMQ_URL="amqp://localhost:5672"

# Only used by the Postman/Newman smoke test (`docker compose --profile
# test run --rm newman`) to log in — must match the admin account your
# `npm run db:seed` created.
SEED_ADMIN_EMAIL="admin@harmonyblend.dev"
SEED_ADMIN_PASSWORD="changeme123"
